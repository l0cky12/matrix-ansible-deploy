---
# ──────────────────────────────────────────────────────────────────────────
#  Global variables — Matrix Synapse deployment on Debian 13
# ──────────────────────────────────────────────────────────────────────────

# ── Identity / domain ────────────────────────────────────────────────────
matrix_domain: matrix.didyoushitmypants.com
matrix_server_name: didyoushitmypants.com
matrix_homeserver_name: matrix.didyoushitmypants.com

# ── Admin ────────────────────────────────────────────────────────────────
matrix_admin_user: "@liam:didyoushitmypants.com"
matrix_admin_password: "CHANGE_ME_ADMIN_PASSWORD"

# ─── Deployer SSH key ────────────────────────────────────────────────────
# Paste the *content* of the public key you will use to log in.
# Example: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPLACEHOLDER replace-this-with-your-actual-key liam@workstation"
deployer_ssh_public_key: "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPLACEHOLDER replace-this-with-your-actual-key liam@workstation"

# ── Deployer account (survives hardening) ────────────────────────────────
deployer_username: liam
deployer_password_hash: "$6$rounds=656000$PLACEHOLDER$REPLACEWITHREALHASH"
ssh_port: 2222

# ── Security ─────────────────────────────────────────────────────────────
timezone: "America/Chicago"
allowed_ssh_networks:
  - "0.0.0.0/0"

# ── PostgreSQL (local, for Synapse) ──────────────────────────────────────
matrix_db_name: synapse
matrix_db_user: synapse
matrix_db_password: "CHANGE_ME_DB_PASSWORD"

# ── Synapse config ──────────────────────────────────────────────────────
matrix_data_dir: /var/lib/matrix-synapse
matrix_config_dir: /etc/matrix-synapse
matrix_signing_key_path: "/etc/matrix-synapse/matrix.didyoushitmypants.com.signing.key"
max_upload_size: "50M"
max_image_pixels: "32M"
synapse_http_port: 8008
synapse_replication_port: 9090
synapse_manhole_enabled: false
federation_domain_whitelist: []
enable_registration: false
registration_shared_secret: ""
message_retention_enabled: false
message_retention_max_lifetime: "1y"
synapse_pkg_name: matrix-synapse

# ── Bot users ────────────────────────────────────────────────────────────
matrix_bot_users:
  - name: "elliot"
    full_name: "Elliot Alderson"
    admin: false
  - name: "grace-hopper"
    full_name: "Grace Hopper"
    admin: false
  - name: "hermes"
    full_name: "Hermes"
    admin: false
  - name: "richard-feynman"
    full_name: "Richard Feynman"
    admin: false
  - name: "william-shakespeare"
    full_name: "William Shakespeare"
    admin: false
  - name: "plutonium1581"
    full_name: "Plutonium1581"
    admin: false

matrix_bot_passwords:
  elliot: "CHANGE_ME_bot_elliot"
  grace-hopper: "CHANGE_ME_bot_grace_hopper"
  hermes: "CHANGE_ME_bot_hermes"
  richard-feynman: "CHANGE_ME_bot_richard_feynman"
  william-shakespeare: "CHANGE_ME_bot_william_shakespeare"
  plutonium1581: "CHANGE_ME_bot_plutonium1581"